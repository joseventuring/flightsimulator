{
  "name": "flightsimulator",
  "productName": "JG RoveaRange",
  "version": "0.11.0",
  "description": "JG RoveaRange: Flight Simulator. Jinu's Garage RC flight simulator, FlySky sim-cable ready.",
  "main": "electron/main.js",
  "author": "Jinu's Garage",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always",
    "build": "python3 build.py",
    "test": "node test/physics.test.js all && node test/fleet.test.js && node test/quad.test.js && node test/vtol.test.js && node test/heli.test.js && node test/battery.test.js"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "three": "0.128.0"
  },
  "build": {
    "appId": "in.jinujose.garage.flightsim",
    "productName": "JG RoveaRange",
    "artifactName": "JG-RoveaRange-${version}-${os}-${arch}.${ext}",
    "files": [
      "index.html",
      "electron/**",
      "icons/**",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "icons/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "icons/icon.png"
    },
    "publish": {
      "provider": "github"
    }
  }
}
